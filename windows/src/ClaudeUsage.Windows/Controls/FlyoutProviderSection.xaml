<UserControl x:Class="ClaudeUsage.Windows.Controls.FlyoutProviderSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:ClaudeUsage.Windows.Accessibility"
             xmlns:controls="clr-namespace:ClaudeUsage.Windows.Controls"
             xmlns:services="clr-namespace:ClaudeUsage.Windows.Services"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:ProviderIcon Width="36"
                                   Height="36"
                                   Provider="{Binding Provider, ElementName=Root}" />

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Heading, ElementName=Root}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,2,0,0"
                            Orientation="Horizontal">
                    <Ellipse Width="5"
                             Height="5"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TertiaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding HeaderStatusText}"
                               MaxWidth="174"
                               FontSize="11"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               AutomationProperties.LiveSetting="Polite"
                               accessibility:LiveRegionBehavior.AnnounceOnTextChanged="True" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="3"
                    Style="{DynamicResource FlyoutPlanBadgeStyle}"
                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibility}}"
                    VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="{Binding PlanBadge}"
                               MaxWidth="86"
                               Style="{DynamicResource FlyoutPlanBadgeTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlanCompactBadge}"
                               MaxWidth="86"
                               Style="{DynamicResource FlyoutPlanBadgeCompactTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Height="30"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}">
            <Grid Width="14"
                  Height="14"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource TrackBrush}"
                         StrokeThickness="2" />
                <Path Width="14"
                      Height="14"
                      AutomationProperties.AutomationId="Motion.FlyoutProviderSpinner"
                      Data="M 7,1 A 6,6 0 1 1 1,7"
                      Stretch="Uniform"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding AnimationsEnabled, Source={x:Static services:SystemMotionSettings.Current}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="FlyoutSpinnerStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="FlyoutSpinnerStoryboard" />
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
            <TextBlock Text="{Binding HeaderStatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource TertiaryTextBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid MinHeight="30"
              Margin="0,10,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasError}" Value="True" />
                                <Condition Binding="{Binding Provider, ElementName=Root}" Value="Claude" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;"
                       Margin="0,0,7,0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{DynamicResource WarningBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding EmptyMessage, ElementName=Root}"
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="4,0"
                    Style="{DynamicResource FlyoutFooterButton}"
                    Content="{DynamicResource UI.Retry}"
                    Click="OnRetryClick" />
        </Grid>

        <TextBlock Margin="0,10,0,0"
                   Text="{Binding EmptyMessage, ElementName=Root}"
                   FontSize="11"
                   Foreground="{DynamicResource TertiaryTextBrush}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding NeedsAction}" Value="True" />
                                <Condition Binding="{Binding Provider, ElementName=Root}" Value="Claude" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl Margin="0,12,0,-12"
                      ItemsSource="{Binding Metrics}"
                      ItemTemplate="{DynamicResource FlyoutMetricTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMetrics}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </StackPanel>
</UserControl>
