<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DesignSystem.swift dark semantic tokens. -->
    <Color x:Key="WindowBackgroundColor">#FF1E1F23</Color>
    <Color x:Key="SurfaceColor">#FF1E1F23</Color>
    <Color x:Key="SecondarySurfaceColor">#FF282A2F</Color>
    <Color x:Key="PrimaryTextColor">#D9FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#C7FFFFFF</Color>
    <Color x:Key="TertiaryTextColor">#8CFFFFFF</Color>
    <Color x:Key="TrackColor">#1FFFFFFF</Color>
    <Color x:Key="BorderColor">#1AFFFFFF</Color>
    <Color x:Key="DividerColor">#14FFFFFF</Color>
    <Color x:Key="WarningColor">#FFFF9500</Color>
    <Color x:Key="DangerColor">#FFF14452</Color>
    <Color x:Key="SuccessColor">#FF51CF66</Color>

    <Color x:Key="DaangnRingColor">#2EFF6F0F</Color>
    <Color x:Key="TossRingColor">#2E3182F6</Color>
    <Color x:Key="HybridRingColor">#2E0EA5E9</Color>
    <Color x:Key="HybridIconStartColor">#FF454D61</Color>
    <Color x:Key="HybridIconEndColor">#FF616B80</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="WidgetPanelBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="WidgetSecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Dark sign-in chrome avoids a light flash around the isolated WebView. -->
    <SolidColorBrush x:Key="LoginWindowBackgroundBrush" Color="#FF171719" />
    <SolidColorBrush x:Key="LoginChromeBackgroundBrush" Color="#FF222226" />
    <SolidColorBrush x:Key="LoginBorderBrush" Color="#FF3A3A40" />
    <SolidColorBrush x:Key="LoginPrimaryTextBrush" Color="#FFF4F1EE" />
    <SolidColorBrush x:Key="LoginSecondaryTextBrush" Color="#FFC2BBB5" />
    <SolidColorBrush x:Key="LoginNoticeBackgroundBrush" Color="#FF3A3021" />
    <SolidColorBrush x:Key="LoginNoticeBorderBrush" Color="#FF725B31" />
    <SolidColorBrush x:Key="LoginNoticeTextBrush" Color="#FFFFD795" />
    <SolidColorBrush x:Key="LoginWebSurfaceBrush" Color="#FF111113" />
    <SolidColorBrush x:Key="LoginWebBorderBrush" Color="#FF3A3A40" />
</ResourceDictionary>
