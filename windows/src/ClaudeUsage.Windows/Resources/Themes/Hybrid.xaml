<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ClaudeUsage.Windows.Views">
    <Color x:Key="AccentColor">#FF0EA5E9</Color>
    <Color x:Key="AccentSecondaryColor">#FF06B6D4</Color>
    <Color x:Key="AccentMutedColor">#FFE2F5FE</Color>
    <Color x:Key="WarningColor">#FFFB731F</Color>
    <Color x:Key="DangerColor">#FFF43F5E</Color>
    <Color x:Key="SuccessColor">#FF34D399</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource HybridRingColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="MetricTrackBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningTrackBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerTrackBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />
    <LinearGradientBrush x:Key="AppIconGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource HybridIconStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource HybridIconEndColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClaudeProviderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CodexProviderBrush" Color="{DynamicResource PrimaryTextColor}" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="#D90EA5E9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource WarningColor}" Offset="0" />
        <GradientStop Color="#D9FB731F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource DangerColor}" Offset="0" />
        <GradientStop Color="#D9F43F5E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WidgetPanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SecondarySurfaceColor}" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="WidgetOuterCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="WidgetInnerCornerRadius">14</CornerRadius>

    <Style x:Key="FlyoutPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontStretch" Value="SemiExpanded" />
        <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}" />
    </Style>

    <Style x:Key="WidgetProviderIconHostStyle" TargetType="Grid">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetProviderTitleHostStyle" TargetType="Grid">
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetProviderTitleRegularStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClaude}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WidgetProviderTitleUpperStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8.1,3.6" />
        <Setter Property="Background" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="5.4" />
    </Style>

    <Style x:Key="WidgetProviderPlanDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderPlanCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontStretch" Value="SemiExpanded" />
        <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}" />
    </Style>

    <DataTemplate x:Key="FlyoutMetricTemplate">
        <Border Padding="14"
                Background="{DynamicResource MetricCardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="14"
                AutomationProperties.Name="{Binding AccessibleName}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"
                                   MaxWidth="150"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Margin="6,0,0,0"
                                Padding="5,1.5"
                                Background="{DynamicResource DividerBrush}"
                                CornerRadius="3">
                            <TextBlock FontSize="9"
                                       FontWeight="ExtraBold"
                                       FontStretch="SemiExpanded"
                                       Foreground="{DynamicResource TertiaryTextBrush}">
                                <TextBlock.Text>
                                    <Binding Converter="{StaticResource FlyoutWindowTagConverter}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ResetText}"
                               Typography.NumeralAlignment="Tabular"
                               MaxWidth="126"
                               Margin="8,0,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ClampedPercent, StringFormat={}{0:0}}"
                                   FontSize="26"
                                   FontWeight="ExtraBold" />
                        <TextBlock Text="%"
                                   Margin="2,0,0,3"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TertiaryTextBrush}">
                        <TextBlock.Text>
                            <Binding Converter="{StaticResource FlyoutUsageCommentConverter}"
                                     ConverterParameter="Hybrid" />
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                <views:WidgetUsageBar Progress="{Binding ClampedPercent}"
                                      Height="8"
                                      Margin="0,10,0,0"
                                      Track="{DynamicResource MetricTrackBrush}">
                    <views:WidgetUsageBar.Style>
                        <Style TargetType="{x:Type views:WidgetUsageBar}">
                            <Setter Property="Fill" Value="{DynamicResource AccentGradientBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource WarningGradientBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Danger">
                                    <Setter Property="Fill" Value="{DynamicResource DangerGradientBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WidgetUsageBar.Style>
                </views:WidgetUsageBar>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetMetricTemplate">
        <StackPanel Margin="0"
                    AutomationProperties.Name="{Binding AccessibleName}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           FontSize="10"
                           FontWeight="ExtraBold"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="12"
                           MaxHeight="24" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ResetText}"
                           Typography.NumeralAlignment="Tabular"
                           Margin="8,0,0,0"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
            <StackPanel Margin="0,6"
                        Orientation="Horizontal">
                <TextBlock Text="{Binding ClampedPercent, StringFormat={}{0:0}}"
                           FontSize="20"
                           FontWeight="ExtraBold" />
                <TextBlock Text="%"
                           Margin="2,0,0,2"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           VerticalAlignment="Bottom" />
            </StackPanel>
            <views:WidgetUsageBar Progress="{Binding ClampedPercent}"
                                  Height="7"
                                  Track="{DynamicResource MetricTrackBrush}">
                <views:WidgetUsageBar.Style>
                    <Style TargetType="{x:Type views:WidgetUsageBar}">
                        <Setter Property="Fill" Value="{DynamicResource AccentGradientBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Fill" Value="{DynamicResource WarningGradientBrush}" />
                                <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Danger">
                                <Setter Property="Fill" Value="{DynamicResource DangerGradientBrush}" />
                                <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:WidgetUsageBar.Style>
            </views:WidgetUsageBar>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
