<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DesignSystem.swift light semantic tokens. -->
    <Color x:Key="WindowBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SecondarySurfaceColor">#FFF9FAFB</Color>
    <Color x:Key="PrimaryTextColor">#DE000000</Color>
    <Color x:Key="SecondaryTextColor">#FF495056</Color>
    <Color x:Key="TertiaryTextColor">#FF868E96</Color>
    <Color x:Key="TrackColor">#FFF1F3F5</Color>
    <Color x:Key="BorderColor">#0F000000</Color>
    <Color x:Key="DividerColor">#FFF1F3F5</Color>
    <Color x:Key="WarningColor">#FFFF9500</Color>
    <Color x:Key="DangerColor">#FFF14452</Color>
    <Color x:Key="SuccessColor">#FF51CF66</Color>

    <Color x:Key="DaangnRingColor">#FFFFE8D6</Color>
    <Color x:Key="TossRingColor">#FFE8F2FF</Color>
    <Color x:Key="HybridRingColor">#FFE2F2FD</Color>
    <Color x:Key="HybridIconStartColor">#FF0F1729</Color>
    <Color x:Key="HybridIconEndColor">#FF1E293B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="WidgetPanelBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="WidgetSecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Sign-in chrome follows app appearance while preserving the warm macOS palette. -->
    <SolidColorBrush x:Key="LoginWindowBackgroundBrush" Color="#FFF7F2ED" />
    <SolidColorBrush x:Key="LoginChromeBackgroundBrush" Color="#FFFCFAF7" />
    <SolidColorBrush x:Key="LoginBorderBrush" Color="#FFE8DED4" />
    <SolidColorBrush x:Key="LoginPrimaryTextBrush" Color="#FF2D2926" />
    <SolidColorBrush x:Key="LoginSecondaryTextBrush" Color="#FF6D625A" />
    <SolidColorBrush x:Key="LoginNoticeBackgroundBrush" Color="#FFFFF3DA" />
    <SolidColorBrush x:Key="LoginNoticeBorderBrush" Color="#FFF0C46B" />
    <SolidColorBrush x:Key="LoginNoticeTextBrush" Color="#FF765116" />
    <SolidColorBrush x:Key="LoginWebSurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="LoginWebBorderBrush" Color="#FFD8CEC4" />
</ResourceDictionary>
