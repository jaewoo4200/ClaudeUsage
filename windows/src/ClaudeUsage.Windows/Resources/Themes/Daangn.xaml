<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ClaudeUsage.Windows.Views">
    <Color x:Key="AccentColor">#FFFF6F0F</Color>
    <Color x:Key="AccentSecondaryColor">#FFFF8F1F</Color>
    <Color x:Key="AccentMutedColor">#FFFFE6D6</Color>
    <Color x:Key="WarningColor">#FFFF9500</Color>
    <Color x:Key="DangerColor">#FFF14452</Color>
    <Color x:Key="SuccessColor">#FF51CF66</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource DaangnRingColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="MetricTrackBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningTrackBrush" Color="{StaticResource WarningColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DangerTrackBrush" Color="{StaticResource DangerColor}" Opacity="0.15" />
    <LinearGradientBrush x:Key="AppIconGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentSecondaryColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClaudeProviderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CodexProviderBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="WidgetPanelBackgroundBrush" Color="{DynamicResource SurfaceColor}" />
    <CornerRadius x:Key="WidgetOuterCornerRadius">22</CornerRadius>
    <CornerRadius x:Key="WidgetInnerCornerRadius">16</CornerRadius>

    <Style x:Key="FlyoutPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderIconHostStyle" TargetType="Grid">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetProviderTitleHostStyle" TargetType="Grid">
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetProviderTitleRegularStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClaude}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WidgetProviderTitleUpperStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8.5,3.4" />
        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <Style x:Key="WidgetProviderPlanDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="9.35" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="WidgetProviderPlanCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <DataTemplate x:Key="FlyoutMetricTemplate">
        <Border Padding="16"
                Background="{DynamicResource MetricCardBackgroundBrush}"
                CornerRadius="16"
                AutomationProperties.Name="{Binding AccessibleName}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               MaxWidth="174"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="8,3"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            CornerRadius="6">
                        <TextBlock Text="{Binding ResetText}"
                                   Typography.NumeralAlignment="Tabular"
                                   MaxWidth="132"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                        <views:WidgetUsageRing Progress="{Binding ClampedPercent}"
                                               Track="{DynamicResource AccentMutedBrush}"
                                               StrokeThickness="6">
                            <views:WidgetUsageRing.Style>
                                <Style TargetType="{x:Type views:WidgetUsageRing}">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Danger">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:WidgetUsageRing.Style>
                        </views:WidgetUsageRing>
                        <TextBlock Text="{Binding PercentageText}"
                                   FontSize="15.5"
                                   FontWeight="ExtraBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ClampedPercent, StringFormat={}{0:0}}"
                                       FontSize="22"
                                       FontWeight="ExtraBold" />
                            <TextBlock Text="%"
                                       Margin="2,0,0,2"
                                       FontSize="14"
                                       FontWeight="ExtraBold"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TertiaryTextBrush}">
                            <TextBlock.Text>
                                <Binding Converter="{StaticResource FlyoutUsageCommentConverter}"
                                         ConverterParameter="Daangn" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetMetricTemplate">
        <Grid Margin="0"
              AutomationProperties.Name="{Binding AccessibleName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="48" Height="48" HorizontalAlignment="Left">
                <views:WidgetUsageRing Progress="{Binding ClampedPercent}"
                                       Track="{DynamicResource AccentMutedBrush}"
                                       StrokeThickness="5">
                    <views:WidgetUsageRing.Style>
                        <Style TargetType="{x:Type views:WidgetUsageRing}">
                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Danger">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WidgetUsageRing.Style>
                </views:WidgetUsageRing>
                <TextBlock Text="{Binding PercentageText}"
                           FontSize="13.44"
                           FontWeight="ExtraBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="13"
                           MaxHeight="26" />
                <TextBlock Text="{Binding ResetText}"
                           Typography.NumeralAlignment="Tabular"
                           Margin="0,2,0,0"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
