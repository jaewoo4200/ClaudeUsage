<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ClaudeUsage.Windows.Views">
    <Color x:Key="AccentColor">#FF3182F6</Color>
    <Color x:Key="AccentSecondaryColor">#FF5AA8FF</Color>
    <Color x:Key="AccentMutedColor">#FFE8F3FF</Color>
    <Color x:Key="WarningColor">#FFFF9500</Color>
    <Color x:Key="DangerColor">#FFF04452</Color>
    <Color x:Key="SuccessColor">#FF51CF66</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource TossRingColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="MetricTrackBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningTrackBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerTrackBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />
    <LinearGradientBrush x:Key="AppIconGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentSecondaryColor}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClaudeProviderBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="CodexProviderBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="WidgetPanelBackgroundBrush" Color="{DynamicResource SurfaceColor}" />
    <CornerRadius x:Key="WidgetOuterCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="WidgetInnerCornerRadius">12</CornerRadius>

    <Style x:Key="FlyoutPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="FlyoutPlanBadgeCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderIconHostStyle" TargetType="Grid">
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderTitleHostStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="WidgetProviderTitleRegularStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="WidgetProviderTitleUpperStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClaude}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WidgetProviderPlanBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="6.8,2.55" />
        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="CornerRadius" Value="5.1" />
    </Style>

    <Style x:Key="WidgetProviderPlanDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="9.35" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="WidgetProviderPlanCompactTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <DataTemplate x:Key="FlyoutMetricTemplate">
        <Border Padding="16"
                Background="{DynamicResource MetricCardBackgroundBrush}"
                CornerRadius="12"
                AutomationProperties.Name="{Binding AccessibleName}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ResetText}"
                               Typography.NumeralAlignment="Tabular"
                               MaxWidth="138"
                               Margin="8,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal">
                    <TextBlock Text="{Binding ClampedPercent, StringFormat={}{0:0}}"
                               FontSize="32"
                               FontWeight="Bold" />
                    <TextBlock Text="%"
                               Margin="4,0,0,4"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               VerticalAlignment="Bottom" />
                </StackPanel>
                <views:WidgetUsageBar Progress="{Binding ClampedPercent}"
                                      Height="6"
                                      Margin="0,10,0,0"
                                      Track="{DynamicResource MetricTrackBrush}">
                    <views:WidgetUsageBar.Style>
                        <Style TargetType="{x:Type views:WidgetUsageBar}">
                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Danger">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:WidgetUsageBar.Style>
                </views:WidgetUsageBar>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="WidgetMetricTemplate">
        <StackPanel Margin="0"
                    AutomationProperties.Name="{Binding AccessibleName}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ClampedPercent, StringFormat={}{0:0}}"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="%"
                               Margin="2,0,0,3"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding ResetText}"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,3"
                           FontSize="10"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
            <TextBlock Text="{Binding Title}"
                       Margin="0,6"
                       FontSize="10"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="12"
                       MaxHeight="24" />
            <views:WidgetUsageBar Progress="{Binding ClampedPercent}"
                                  Height="5"
                                  Track="{DynamicResource MetricTrackBrush}">
                <views:WidgetUsageBar.Style>
                    <Style TargetType="{x:Type views:WidgetUsageBar}">
                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="Track" Value="{DynamicResource WarningTrackBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Danger">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Track" Value="{DynamicResource DangerTrackBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:WidgetUsageBar.Style>
            </views:WidgetUsageBar>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
