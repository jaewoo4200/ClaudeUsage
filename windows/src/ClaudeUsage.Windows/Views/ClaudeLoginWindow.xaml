<Window x:Class="ClaudeUsage.Windows.Views.ClaudeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:accessibility="clr-namespace:ClaudeUsage.Windows.Accessibility"
        xmlns:services="clr-namespace:ClaudeUsage.Windows.Services"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource ClaudeLogin.Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        services:WindowWorkAreaSizingBehavior.PreferredClientWidth="520"
        services:WindowWorkAreaSizingBehavior.PreferredClientHeight="760"
        services:WindowWorkAreaSizingBehavior.MinimumClientWidth="460"
        services:WindowWorkAreaSizingBehavior.MinimumClientHeight="640"
        services:WindowWorkAreaSizingBehavior.PhysicalMarginPixels="12"
        services:WindowWorkAreaSizingBehavior.IsEnabled="True"
        Background="{DynamicResource LoginWindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="LoginToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource LoginSecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource LoginWindowBackgroundBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource LoginPrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource LoginBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LoginSurface"
          Width="520"
          Height="760"
          Background="{DynamicResource LoginWebSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="LoginToolbar"
                Grid.Row="0"
                Height="36"
                Padding="10,6"
                Background="{DynamicResource LoginChromeBackgroundBrush}"
                BorderBrush="{DynamicResource LoginBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ReloadButton"
                            Style="{StaticResource LoginToolbarButton}"
                            Margin="0,0,4,0"
                            Click="ReloadButton_Click"
                            ToolTip="{DynamicResource ClaudeLogin.Reload}"
                            AutomationProperties.Name="{DynamicResource ClaudeLogin.Reload}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE72C;" />
                    </Button>
                    <Button x:Name="OpenInDefaultBrowserButton"
                            Style="{StaticResource LoginToolbarButton}"
                            Margin="0,0,4,0"
                            Click="OpenInDefaultBrowserButton_Click"
                            ToolTip="{DynamicResource ClaudeLogin.OpenInBrowser}"
                            AutomationProperties.Name="{DynamicResource ClaudeLogin.OpenInBrowser}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE8A7;" />
                    </Button>
                    <Button x:Name="ClearLoginDataButton"
                            Style="{StaticResource LoginToolbarButton}"
                            Click="ClearLoginDataButton_Click"
                            ToolTip="{DynamicResource ClaudeLogin.ClearData}"
                            AutomationProperties.Name="{DynamicResource ClaudeLogin.ClearData}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE74D;" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="10,4"
                        Background="{DynamicResource LoginBorderBrush}" />

                <Grid Grid.Column="2" Margin="0,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}"
                               Text="&#xE72E;" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource LoginSecondaryTextBrush}"
                               Text="{DynamicResource ClaudeLogin.Status.Preparing}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.LiveSetting="Polite"
                               accessibility:LiveRegionBehavior.AnnounceOnTextChanged="True" />
                </Grid>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="LoginWebView"
                      Grid.Row="1"
                      Margin="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    </Grid>
</Window>
