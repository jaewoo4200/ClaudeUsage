<UserControl x:Class="ClaudeUsage.Windows.Views.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClaudeUsage.Windows.Controls"
             xmlns:local="clr-namespace:ClaudeUsage.Windows.Views"
             Background="Transparent"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <local:WidgetBooleanToVisibilityConverter x:Key="BoolVisibility" />
        <local:WidgetPanelKindVisibilityConverter x:Key="PanelVisibility" />

        <Style x:Key="WidgetDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>

        <Style x:Key="WidgetHorizontalDivider"
               TargetType="Border"
               BasedOn="{StaticResource WidgetDivider}">
            <Setter Property="Margin" Value="0,10" />
        </Style>

        <Style x:Key="WidgetPageButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource WidgetSecondarySurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BriefVectorIcon" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="BriefLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BriefValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="CompactCompanionTemplate">
            <controls:CompanionControl Companion="{Binding Companion.SelectedCompanion}"
                                       Mood="{Binding Companion.Mood}"
                                       AnimationMode="{Binding Companion.AnimationMode}"
                                       ReducedMotion="{Binding Companion.ReducedMotion}"
                                       BubbleText="{Binding Companion.BubbleText}"
                                       MoodTitle="{Binding Companion.MoodTitle}"
                                       DetailText="{Binding Companion.DetailText}"
                                       Pressure="{Binding Companion.Pressure}"
                                       TrendPoints="{Binding Companion.TrendPoints}"
                                       AvatarSize="66"
                                       PresentationMode="Compact"
                                       HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="{Binding Companion.AccessibilityLabel}" />
        </DataTemplate>

        <DataTemplate x:Key="WideCompanionTemplate">
            <controls:CompanionControl Companion="{Binding Companion.SelectedCompanion}"
                                       Mood="{Binding Companion.Mood}"
                                       AnimationMode="{Binding Companion.AnimationMode}"
                                       ReducedMotion="{Binding Companion.ReducedMotion}"
                                       BubbleText="{Binding Companion.BubbleText}"
                                       MoodTitle="{Binding Companion.MoodTitle}"
                                       DetailText="{Binding Companion.DetailText}"
                                       Pressure="{Binding Companion.Pressure}"
                                       TrendPoints="{Binding Companion.TrendPoints}"
                                       AvatarSize="78"
                                       PresentationMode="Wide"
                                       HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="{Binding Companion.AccessibilityLabel}" />
        </DataTemplate>

        <Style x:Key="WidgetSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WidgetPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource WidgetOuterCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid x:Name="CombinedLayoutHost">
            <Border x:Name="StackedSurface"
                    Width="240"
                    Padding="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource WidgetSurface}">
                <StackPanel>
                    <local:WidgetProviderCard DataContext="{Binding Claude}" />
                    <Border Style="{StaticResource WidgetDivider}" />
                    <local:WidgetProviderCard DataContext="{Binding Codex}" />
                    <Border Style="{StaticResource WidgetDivider}"
                            Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource CompactCompanionTemplate}"
                                    Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Border>

            <Viewbox x:Name="HorizontalViewport"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">
                <Border x:Name="HorizontalSurface"
                        Width="480"
                        Padding="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Style="{StaticResource WidgetSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <local:WidgetProviderCard DataContext="{Binding Claude}" />
                        <Border Style="{StaticResource WidgetHorizontalDivider}"
                                Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource WideCompanionTemplate}"
                                        Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <local:WidgetProviderCard DataContext="{Binding Codex}" />
                        <Border Style="{StaticResource WidgetHorizontalDivider}" />
                        <Grid Height="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="HeadroomGaugeIcon"
                                  Data="M 1.5,9.5 A 5.5,5.5 0 0 1 12.5,9.5 M 7,9.5 L 10.4,5.8 M 4.4,11.5 L 9.6,11.5">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource BriefVectorIcon}">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeadroomLevel}" Value="Warning">
                                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeadroomLevel}" Value="Danger">
                                                <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Grid.Column="1" Text="{Binding HeadroomLabel}" Style="{StaticResource BriefLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding HeadroomText}" Style="{StaticResource BriefValue}" />
                        </Grid>
                        <Grid Height="18" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="NextResetClockIcon"
                                  Data="M 11.7,5 A 5,5 0 1 0 11.8,9.2 M 11.7,5 L 11.7,1.8 L 8.6,2.1 M 7,4.2 L 7,7.1 L 9.1,8.4"
                                  Style="{StaticResource BriefVectorIcon}"
                                  Stroke="{DynamicResource WarningBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding NextResetLabel}" Style="{StaticResource BriefLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding NextResetSummary}" MaxWidth="110" Style="{StaticResource BriefValue}" />
                        </Grid>
                        <Grid Height="18" Margin="0,7,0,0" Visibility="{Binding HasResetCredits, Converter={StaticResource BoolVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="ResetCreditsTicketIcon"
                                  Data="M 2,3.5 H 12 V 5 C 10.8,5 10.8,7 12,7 V 10.5 H 2 V 7 C 3.2,7 3.2,5 2,5 Z M 8.8,4.6 V 5.3 M 8.8,6.2 V 7 M 8.8,7.9 V 8.7"
                                  Style="{StaticResource BriefVectorIcon}"
                                  Stroke="{DynamicResource AccentSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding ResetCreditsLabel}" Style="{StaticResource BriefLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding ResetCreditsSummary}" MaxWidth="90" Style="{StaticResource BriefValue}" />
                        </Grid>
                        <Grid Height="18" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="RecentActivityChartIcon"
                                  Data="M 2,2 V 12 H 12 M 3.5,9 L 6,6.5 L 8,8 L 11.5,4"
                                  Style="{StaticResource BriefVectorIcon}"
                                  Stroke="{DynamicResource SuccessBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding RecentActivityLabel}" Style="{StaticResource BriefLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding RecentActivitySummary}" MaxWidth="88" Style="{StaticResource BriefValue}" />
                        </Grid>
                        <Grid Height="18" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="TokensTodaySumIcon"
                                  Data="M 11.5,2 H 3 L 7,7 L 3,12 H 11.5"
                                  Style="{StaticResource BriefVectorIcon}"
                                  Stroke="{DynamicResource AccentSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding TokensTodayLabel}" Style="{StaticResource BriefLabel}" />
                            <TextBlock Grid.Column="2" Text="{Binding TokensTodaySummary}" MaxWidth="88" Style="{StaticResource BriefValue}" />
                        </Grid>
                    </StackPanel>
                </Grid>
                </Border>
            </Viewbox>

            <Border x:Name="PagedSurface"
                    Width="240"
                    Padding="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource WidgetSurface}">
                <StackPanel>
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource WidgetPageButton}"
                                Command="{Binding PreviousProviderCommand}"
                                ToolTip="{DynamicResource Widget.PreviousProvider}"
                                AutomationProperties.Name="{DynamicResource Widget.PreviousProvider}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 6,1 L 2,5 L 6,9"
                                  IsHitTestVisible="False"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Stretch="Uniform" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClaudePage}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCodexPage}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding PagedProviderName}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource WidgetPageButton}"
                                Command="{Binding NextProviderCommand}"
                                ToolTip="{DynamicResource Widget.NextProvider}"
                                AutomationProperties.Name="{DynamicResource Widget.NextProvider}">
                            <Path Width="6"
                                  Height="10"
                                  Data="M 2,1 L 6,5 L 2,9"
                                  IsHitTestVisible="False"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.75"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <local:WidgetProviderCard x:Name="PagedCard"
                                              Margin="0,8,0,0"
                                              AutomationProperties.AutomationId="Motion.PagedCard"
                                              DataContext="{Binding PagedProvider}"
                                              DataContextChanged="OnPagedCardDataContextChanged" />

                    <Border Style="{StaticResource WidgetDivider}"
                            Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource CompactCompanionTemplate}"
                                    Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ClaudeSurface"
                Width="240"
                Padding="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource WidgetSurface}">
            <StackPanel>
                <local:WidgetProviderCard DataContext="{Binding Claude}" />
                <Border Style="{StaticResource WidgetDivider}" Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource CompactCompanionTemplate}"
                                Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </Border>

        <Border x:Name="CodexSurface"
                Width="240"
                Padding="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource WidgetSurface}">
            <StackPanel>
                <local:WidgetProviderCard DataContext="{Binding Codex}" />
                <Border Style="{StaticResource WidgetDivider}" Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource CompactCompanionTemplate}"
                                Visibility="{Binding ShowCompanion, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
