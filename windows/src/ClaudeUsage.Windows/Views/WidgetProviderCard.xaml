<UserControl x:Class="ClaudeUsage.Windows.Views.WidgetProviderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accessibility="clr-namespace:ClaudeUsage.Windows.Accessibility"
             xmlns:controls="clr-namespace:ClaudeUsage.Windows.Controls"
             xmlns:local="clr-namespace:ClaudeUsage.Windows.Views"
             xmlns:services="clr-namespace:ClaudeUsage.Windows.Services"
             Focusable="False"
             Background="Transparent">
    <UserControl.Resources>
        <local:WidgetBooleanToVisibilityConverter x:Key="BoolVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Grid x:Name="ProviderIconHost"
                      Style="{DynamicResource WidgetProviderIconHostStyle}">
                    <controls:ProviderIcon Provider="Claude"
                                           Width="{Binding ActualWidth, ElementName=ProviderIconHost}"
                                           Height="{Binding ActualHeight, ElementName=ProviderIconHost}"
                                           Visibility="{Binding IsClaude, Converter={StaticResource BoolVisibility}}" />
                    <controls:ProviderIcon Provider="Codex"
                                           Width="{Binding ActualWidth, ElementName=ProviderIconHost}"
                                           Height="{Binding ActualHeight, ElementName=ProviderIconHost}"
                                           Visibility="{Binding IsClaude, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                </Grid>
                <Grid Style="{DynamicResource WidgetProviderTitleHostStyle}">
                    <TextBlock Text="{Binding DisplayName}"
                               Style="{DynamicResource WidgetProviderTitleRegularStyle}" />
                    <TextBlock Text="{Binding UpperDisplayName}"
                               Style="{DynamicResource WidgetProviderTitleUpperStyle}" />
                </Grid>
            </StackPanel>

            <Border Grid.Column="1"
                    Style="{DynamicResource WidgetProviderPlanBadgeStyle}"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}">
                <Grid>
                    <TextBlock Text="{Binding PlanBadge}"
                               MaxWidth="78"
                               Style="{DynamicResource WidgetProviderPlanDisplayTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlanCompactBadge}"
                               MaxWidth="78"
                               Style="{DynamicResource WidgetProviderPlanCompactTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Ellipse Grid.Column="1"
                      Width="6"
                      Height="6"
                      VerticalAlignment="Center"
                      Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TertiaryTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClaude}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>

        <Grid Height="38"
              HorizontalAlignment="Left"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
            <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource TrackBrush}"
                         StrokeThickness="2" />
                <Path Width="14"
                      Height="14"
                      AutomationProperties.AutomationId="Motion.WidgetProviderSpinner"
                      Data="M 7,1 A 6,6 0 1 1 1,7"
                      Stretch="Uniform"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                        <Condition Binding="{Binding AnimationsEnabled, Source={x:Static services:SystemMotionSettings.Current}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="WidgetSpinnerStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="WidgetSpinnerStoryboard" />
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Grid>

        <TextBlock Text="{Binding StatusText}"
                   Margin="0"
                   Padding="0,12"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="11"
                   LineHeight="13"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   accessibility:LiveRegionBehavior.AnnounceOnTextChanged="True"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl Margin="0,0,0,-8"
                      ItemsSource="{Binding Metrics}"
                      ItemTemplate="{DynamicResource WidgetMetricTemplate}"
                      Visibility="{Binding HasMetrics, Converter={StaticResource BoolVisibility}}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </StackPanel>
</UserControl>
