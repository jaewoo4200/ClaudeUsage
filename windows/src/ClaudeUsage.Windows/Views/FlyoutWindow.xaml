<Window x:Class="ClaudeUsage.Windows.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClaudeUsage.Windows.Controls"
        xmlns:services="clr-namespace:ClaudeUsage.Windows.Services"
        x:Name="Root"
        Title="ClaudeUsage"
        Width="360"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border x:Name="FlyoutChrome"
            Padding="19"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource FlyoutOuterCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="FlyoutScroll"
                          MaxHeight="560"
                          Style="{StaticResource FlyoutOverlayScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <StackPanel>
                    <Border Margin="0,0,0,16"
                            Padding="10"
                            Background="{DynamicResource MetricCardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowCompanion, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:CompanionControl AvatarSize="58"
                                                   PresentationMode="Summary"
                                                   Companion="{Binding Companion.SelectedCompanion}"
                                                   Mood="{Binding Companion.Mood}"
                                                   AnimationMode="{Binding Companion.AnimationMode}"
                                                   ReducedMotion="{Binding Companion.ReducedMotion}"
                                                   BubbleText="{Binding Companion.BubbleText}"
                                                   Pressure="{Binding Companion.Snapshot.Pressure, TargetNullValue=0}"
                                                   TrendPoints="{Binding Companion.Trend.Points}">
                            <controls:CompanionControl.MoodTitle>
                                <MultiBinding Converter="{StaticResource FlyoutMoodTitleConverter}">
                                    <Binding Path="Companion.Mood" />
                                    <Binding Path="Companion.Language" />
                                </MultiBinding>
                            </controls:CompanionControl.MoodTitle>
                            <controls:CompanionControl.DetailText>
                                <MultiBinding Converter="{StaticResource FlyoutCompanionDetailConverter}">
                                    <Binding Path="Companion.RecentTokenText" />
                                    <Binding Path="Companion.PaceText" />
                                    <Binding Path="Companion.PressureText" />
                                    <Binding Path="Companion.Language" />
                                </MultiBinding>
                            </controls:CompanionControl.DetailText>
                        </controls:CompanionControl>
                    </Border>

                    <StackPanel>
                        <controls:FlyoutProviderSection DataContext="{Binding Claude}"
                                                        Provider="Claude"
                                                        Heading="{Binding ClaudeUsageTitle, ElementName=Root}"
                                                        EmptyMessage="{Binding UsageViewModel.ClaudeStatusDetail, ElementName=Root}"
                                                        RetryRequested="OnProviderRetryRequested" />
                        <Button Margin="0,10,0,0"
                                Style="{StaticResource FlyoutActionButton}"
                                Content="{DynamicResource UI.ClaudeLogin}"
                                AutomationProperties.Name="{DynamicResource UI.ClaudeLogin}"
                                Visibility="{Binding UsageViewModel.ClaudeNeedsLogin, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OnClaudeLoginClick" />
                    </StackPanel>

                    <Border Height="1"
                            Margin="0,16"
                            Background="{DynamicResource DividerBrush}" />

                    <StackPanel>
                        <controls:FlyoutProviderSection DataContext="{Binding Codex}"
                                                        Provider="Codex"
                                                        Heading="{Binding CodexUsageTitle, ElementName=Root}"
                                                        EmptyMessage="{Binding UsageViewModel.StatusDetail, ElementName=Root}"
                                                        RetryRequested="OnProviderRetryRequested" />
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding UsageViewModel.HasError, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding UsageViewModel.StatusDetail, ElementName=Root}"
                                       Margin="0,0,0,10"
                                       FontSize="11"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Style="{StaticResource FlyoutActionButton}"
                                    Content="{DynamicResource UI.OpenUsagePage}"
                                    AutomationProperties.Name="{DynamicResource UI.OpenUsagePage}"
                                    Click="OnOpenCodexUsageClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1">
                <Border Height="1"
                        Margin="0,14,0,0"
                        Background="{DynamicResource DividerBrush}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource FlyoutFooterButton}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding WidgetActionText, ElementName=Root}"
                            Click="OnToggleWidgetClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE737;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="5,0,0,0"
                                       Text="{Binding WidgetActionText, ElementName=Root}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource FlyoutIconButton}"
                                ToolTip="{DynamicResource UI.OpenUsage}"
                                AutomationProperties.Name="{DynamicResource UI.OpenUsage}"
                                Click="OnUsageHistoryClick">
                            <TextBlock Text="&#xE9D2;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Margin="2,0,0,0"
                                Style="{StaticResource FlyoutIconButton}"
                                ToolTip="{DynamicResource UI.Settings}"
                                AutomationProperties.Name="{DynamicResource UI.Settings}"
                                Click="OnSettingsClick">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Margin="2,0,0,0"
                                Style="{StaticResource FlyoutIconButton}"
                                ToolTip="{DynamicResource UI.Refresh}"
                                AutomationProperties.Name="{DynamicResource UI.Refresh}"
                                Click="OnRefreshClick">
                            <TextBlock Text="&#xE72C;"
                                       AutomationProperties.AutomationId="Motion.FlyoutFooterSpinner"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding UsageViewModel.IsAnyProviderRefreshing, ElementName=Root}" Value="True" />
                                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding AnimationsEnabled, Source={x:Static services:SystemMotionSettings.Current}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="FooterRefreshStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="FooterRefreshStoryboard" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Margin="2,0,0,0"
                                Style="{StaticResource FlyoutIconButton}"
                                ToolTip="{DynamicResource UI.ClaudeLogout}"
                                AutomationProperties.Name="{DynamicResource UI.ClaudeLogout}"
                                Visibility="{Binding UsageViewModel.ClaudeHasSnapshot, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OnClaudeLogoutClick">
                            <TextBlock Text="&#xE8AC;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Margin="2,0,0,0"
                                Style="{StaticResource FlyoutIconButton}"
                                ToolTip="{DynamicResource UI.Quit}"
                                AutomationProperties.Name="{DynamicResource UI.Quit}"
                                Click="OnQuitClick">
                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
